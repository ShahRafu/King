<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shahrafuking.kingassistant">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <application
        android:allowBackup="true"
        android:label="King Assistant"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <!-- MainActivity (entrypoint) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Enrollment & Verification UIs -->
        <activity android:name=".ui.EnrollmentActivity" android:exported="false" />
        <activity android:name=".ui.VerificationActivity" android:exported="false" />

        <!-- OverlayService: foreground service with microphone usage -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Accessibility AutoClickService (disabled by default) -->
        <service
            android:name=".accessibility.AutoClickService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- LLM Test / Model Management UI (for on-device mock testing) -->
        <activity
            android:name=".ui.LLMTestActivity"
            android:exported="false" />

        <!-- High Security Approval UI -->
        <activity
            android:name=".ui.HighSecurityApprovalActivity"
            android:exported="false" />

    </application>
</manifest>
